-kaggle-v1"],"original_url":"https://x.com/realdonaldtrump/status/1884022748","source_deleted_flag":false,"media_count":0,"text_source":"3dl-kaggle-v1","content_status":"text"},{"id":"x:1878373267","platform":"x","post_id":"1878373267","published_at":"2009-05-22T02:59:39.000Z","text":"\"Keep it fast, short and direct - whatever it is.\" --Donald J. Trump http://tinyurl.com/pqpfvm","kind":"original","source_ids":["3dl-kaggle-v1"],"original_url":"https://x.com/realdonaldtrump/status/1878373267","source_deleted_flag":false,"media_count":0,"text_source":"3dl-kaggle-v1","content_status":"text"},{"id":"x:1864367186","platform":"x","post_id":"1864367186","published_at":"2009-05-20T22:29:47.000Z","text":"Read a great interview with Donald Trump that appeared in The New York Times Magazine: http://tinyurl.com/qsx4o6","kind":"original","source_ids":["3dl-kaggle-v1"],"original_url":"https://x.com/realdonaldtrump/status/1864367186","source_deleted_flag":false,"media_count":0,"text_source":"3dl-kaggle-v1","content_status":"text"},{"id":"x:1859044981","platform":"x","post_id":"1859044981","published_at":"2009-05-20T13:25:39.000Z","text":"\"Always know you could be on the precipice of something great.\" --Donald J. Trump http://tinyurl.com/pqpfvm","kind":"original","source_ids":["3dl-kaggle-v1"],"original_url":"https://x.com/realdonaldtrump/status/1859044981","source_deleted_flag":false,"media_count":0,"text_source":"3dl-kaggle-v1","content_status":"text"},{"id":"x:1849558306","platform":"x","post_id":"1849558306","published_at":"2009-05-19T17:43:39.000Z","text":"\"...these days...we could all use a little of the power of Trumpative thinking.\" –BarnesandNoble.com http://tinyurl.com/pqpfvm","kind":"original","source_ids":["3dl-kaggle-v1"],"original_url":"https://x.com/realdonaldtrump/status/1849558306","source_deleted_flag":false,"media_count":0,"text_source":"3dl-kaggle-v1","content_status":"text"},{"id":"x:1836131903","platform":"x","post_id":"1836131903","published_at":"2009-05